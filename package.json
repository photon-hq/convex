{
  "name": "@photon-ai/convex",
  "version": "0.1.0",
  "description": "Convex component for Photon — durable inbound pipeline, batching, cancellation, and a deduped, paced outbox.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/convex.git"
  },
  "homepage": "https://github.com/photon-hq/convex#readme",
  "bugs": {
    "url": "https://github.com/photon-hq/convex/issues"
  },
  "keywords": [
    "convex",
    "convex-component",
    "imessage",
    "sms",
    "whatsapp",
    "email",
    "telegram"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "scripts": {
    "predev": "pnpm run build:codegen",
    "dev": "convex dev --typecheck-components --start 'pnpm run dev:build'",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'pnpm run build:codegen' --initial",
    "build": "tsc --project tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && pnpm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm run build:codegen",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p example/convex",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@photon-ai/api": "0.6.0",
    "standardwebhooks": "^1.1.1"
  },
  "peerDependencies": {
    "convex": ">=1.31.0 <2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.0.1",
    "chokidar-cli": "^3.0.0",
    "convex": "^1.44.0",
    "convex-test": "^0.0.56",
    "typescript": "^5.9.0",
    "ultracite": "7.8.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.13.1"
}
