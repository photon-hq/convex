{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "off",
        "noEmptyBlockStatements": "off"
      }
    }
  },
  "overrides": [
    {
      // The public package entry point: re-exporting is its job.
      "includes": ["src/client/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "files": {
    // _generated/ is written by `convex codegen`; example/ is a sample app
    // with its own generated tree.
    "includes": ["!**/_generated", "!dist", "!bun.lock"]
  }
}
